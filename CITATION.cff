    given-names: Simon
    orcid: "https://orcid.org/0009-0007-4304-6956"
date-released: "2025-11-03"
license: MIT
repository-code: "https://github.com/spoorendonk/rcspp_dataset"
url: "https://github.com/spoorendonk/rcspp_dataset"
keywords:
  - resource constrained shortest path problem
  - vehicle routing
  - column generation
  - pricing problem
  - ng-path relaxation
  - benchmark instances
references:
  - type: article
    title: "Algorithms for the Vehicle Routing and Scheduling Problems with Time Window Constraints"
    authors:
      - family-names: Solomon
        given-names: "Marius M."
    journal: "Operations Research"
    volume: 35
    issue: 2
    start: 254
    end: 265
    year: 1987
    doi: "10.1287/opre.35.2.254"
    notes: "The original Solomon VRPTW instances from which these RCSPP pricing instances are generated."
